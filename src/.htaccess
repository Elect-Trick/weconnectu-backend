<IfModule mod_rewrite.c>
    RewriteEngine On

    # Stop processing if the requested path is an actual existing file or folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f

    # Route everything else through your index.php entry point
    RewriteRule ^ index.php [L]
</IfModule>
